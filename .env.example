# PromiseProof - configuration

# Nebius Token Factory API key - only needed for the live extraction pipeline
# (the web app's /api/extract-stream). The verification cycle, the seed, and
# the MCP ledger tools never call an LLM. Get a key (and hackathon credits):
# https://studio.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here

# Leave this UNSET in normal use - LiteLLM already points the "nebius/"
# provider at the right endpoint (https://api.studio.nebius.ai/v1). Only set
# it to override, and then match whatever your Nebius console shows exactly.
# NEBIUS_API_BASE=https://api.studio.nebius.ai/v1

# Extractor model - an NVIDIA open-source model served through Nebius Token
# Factory, as the "Nebius x NVIDIA Global AI Hackathon" rules require (must
# use at least one NVIDIA open-source model). The "nebius/" LiteLLM provider
# prefix is optional - the code adds it, and strips it first if you include
# it. Check your Nebius console for the exact current model id; Nemotron ids
# are renamed/retired over time.
MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1

# Adversarial auditor model - a genuinely different-sized NVIDIA Nemotron
# model gives an independent second read on "is this promise actually
# falsifiable" (and satisfies the NVIDIA-model requirement a second time).
AUDITOR_MODEL=nvidia/Llama-3_1-Nemotron-Nano-8B-v1

# Ledger backend: json (default, data/ledger.json - the seeded demo ships
# this way) | firestore | memory
LEDGER_BACKEND=json
# LEDGER_JSON_PATH=./data/ledger.json

# FastMCP server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# Web app port
WEB_APP_PORT=8000
